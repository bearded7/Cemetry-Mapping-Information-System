# Sample nginx reverse-proxy config for the Cemetery Mapping & Information
# System. Copy to /etc/nginx/sites-available/, adjust the domain and
# certificate paths, then symlink into sites-enabled and reload nginx.
#
# Get a free certificate with: sudo certbot --nginx -d your-domain.example

upstream cemetery_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.example;

    ssl_certificate     /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 25m; # room for multiple grave/message photo uploads

    access_log /var/log/nginx/cemetery-registry.access.log;
    error_log  /var/log/nginx/cemetery-registry.error.log;

    location / {
        proxy_pass http://cemetery_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Serve uploaded photos/attachments directly from disk for lower
    # latency, bypassing Node - optional but recommended at scale.
    location /uploads/ {
        alias /opt/cemetery-registry/uploads/;
        add_header X-Content-Type-Options nosniff;
        add_header Content-Security-Policy "default-src 'none'";
        expires 7d;
    }
}

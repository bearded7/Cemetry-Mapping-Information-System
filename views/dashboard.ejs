<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <div class="container py-4">
    <div class="row">
      <div class="col-md-12">
        <h2 class="mb-4">Dashboard</h2>
        <p class="text-muted">Welcome back, <strong><%= user.full_name %></strong>!</p>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
      <div class="col-md-3">
        <div class="card dashboard-stat-card">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted">Cemeteries</h6>
                <h2 class="mb-0"><%= stats.total_cemeteries || 0 %></h2>
              </div>
              <i class="fas fa-tree fa-2x text-primary opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card dashboard-stat-card">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted">Graves</h6>
                <h2 class="mb-0"><%= stats.total_graves || 0 %></h2>
              </div>
              <i class="fas fa-cross fa-2x text-success opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card dashboard-stat-card">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted">My Photos</h6>
                <h2 class="mb-0"><%= stats.my_photos || 0 %></h2>
              </div>
              <i class="fas fa-camera fa-2x text-info opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card dashboard-stat-card">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted">Messages</h6>
                <h2 class="mb-0"><%= stats.unread_messages || 0 %></h2>
              </div>
              <i class="fas fa-envelope fa-2x text-warning opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <!-- Pending Approvals (Admin Only) -->
      <% if (isAdmin) { %>
        <div class="col-md-12 mb-4">
          <div class="card">
            <div class="card-header bg-primary text-white">
              <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Pending Approvals</h5>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-4">
                  <h6>Users (<%= pendingUsers.length %>)</h6>
                  <% if (pendingUsers.length > 0) { %>
                    <ul class="list-unstyled">
                      <% pendingUsers.forEach(user => { %>
                        <li class="pending-item">
                          <strong><%= user.full_name %></strong>
                          <small class="text-muted d-block"><%= user.email %></small>
                          <div class="mt-1">
                            <form action="/admin/users/<%= user.id %>/approve" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-success btn-sm">Approve</button>
                            </form>
                            <form action="/admin/users/<%= user.id %>/reject" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                            </form>
                          </div>
                        </li>
                      <% }) %>
                    </ul>
                  <% } else { %>
                    <p class="text-muted">No pending users</p>
                  <% } %>
                </div>
                <div class="col-md-4">
                  <h6>Cemeteries (<%= pendingCemeteries.length %>)</h6>
                  <% if (pendingCemeteries.length > 0) { %>
                    <ul class="list-unstyled">
                      <% pendingCemeteries.forEach(cemetery => { %>
                        <li class="pending-item">
                          <strong><%= cemetery.name %></strong>
                          <small class="text-muted d-block">by <%= cemetery.created_by_name || 'Unknown' %></small>
                          <div class="mt-1">
                            <form action="/admin/cemeteries/<%= cemetery.id %>/approve" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-success btn-sm">Approve</button>
                            </form>
                            <form action="/admin/cemeteries/<%= cemetery.id %>/reject" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                            </form>
                          </div>
                        </li>
                      <% }) %>
                    </ul>
                  <% } else { %>
                    <p class="text-muted">No pending cemeteries</p>
                  <% } %>
                </div>
                <div class="col-md-4">
                  <h6>Graves (<%= pendingGraves.length %>)</h6>
                  <% if (pendingGraves.length > 0) { %>
                    <ul class="list-unstyled">
                      <% pendingGraves.forEach(grave => { %>
                        <li class="pending-item">
                          <strong><%= grave.deceased_name %></strong>
                          <small class="text-muted d-block">
                            <%= grave.cemetery_name || 'Unknown Cemetery' %>
                            by <%= grave.created_by_name || 'Unknown' %>
                          </small>
                          <div class="mt-1">
                            <form action="/admin/graves/<%= grave.id %>/approve" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-success btn-sm">Approve</button>
                            </form>
                            <form action="/admin/graves/<%= grave.id %>/reject" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                            </form>
                          </div>
                        </li>
                      <% }) %>
                    </ul>
                  <% } else { %>
                    <p class="text-muted">No pending graves</p>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- My Graves -->
      <div class="col-md-8">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-cross me-2"></i>My Graves</h5>
          </div>
          <div class="card-body">
            <% if (userGraves && userGraves.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Cemetery</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% userGraves.forEach(grave => { %>
                      <tr>
                        <td><%= grave.deceased_name %></td>
                        <td><%= grave.cemetery_name || 'N/A' %></td>
                        <td>
                          <% if (grave.is_approved) { %>
                            <span class="badge bg-success">Approved</span>
                          <% } else { %>
                            <span class="badge bg-warning">Pending</span>
                          <% } %>
                        </td>
                        <td>
                          <a href="/graves/<%= grave.id %>" class="btn btn-sm btn-primary">View</a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <p class="text-muted">You haven't added any graves yet.</p>
              <a href="/graves/new" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Add Your First Grave
              </a>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Recent Messages -->
      <div class="col-md-4">
        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-envelope me-2"></i>Recent Messages</h5>
            <a href="/messages" class="btn btn-sm btn-primary">View All</a>
          </div>
          <div class="card-body">
            <% if (messages && messages.length > 0) { %>
              <% messages.forEach(msg => { %>
                <div class="message-preview <%= msg.is_read ? '' : 'unread' %>">
                  <strong><%= msg.sender_name || 'System' %></strong>
                  <p class="mb-0 text-truncate"><%= msg.subject %></p>
                  <small class="text-muted">
                    <%= new Date(msg.created_at).toLocaleDateString() %>
                    <% if (!msg.is_read) { %>
                      <span class="badge bg-primary float-end">New</span>
                    <% } %>
                  </small>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-muted">No messages</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/main.js"></script>
</body>
</html>
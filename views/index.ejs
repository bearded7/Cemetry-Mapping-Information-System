<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="row align-items-center min-vh-75">
        <div class="col-lg-6">
          <h1 class="display-3 fw-bold mb-4">
            <span class="text-primary">Locate Graves</span> of Loved Ones Easily
          </h1>
          <p class="lead mb-4">
            The Cemetery Mapping Information System helps you find graves, 
            navigate cemeteries, and preserve memories with our interactive map.
          </p>
          <div class="d-flex gap-3 flex-wrap">
            <a href="/map" class="btn btn-primary btn-lg">
              <i class="fas fa-map-marked-alt me-2"></i>Explore Map
            </a>
            <a href="/cemeteries" class="btn btn-outline-secondary btn-lg">
              <i class="fas fa-search me-2"></i>Browse Cemeteries
            </a>
            <% if (!isAuthenticated) { %>
              <a href="/auth/register" class="btn btn-success btn-lg">
                <i class="fas fa-user-plus me-2"></i>Sign Up
              </a>
            <% } %>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="hero-image-container">
            <img src="/public/images/cemetery-hero.jpg" alt="Cemetery" class="img-fluid rounded-3 shadow-lg" 
                 onerror="this.src='https://via.placeholder.com/600x400/2c3e7a/ffffff?text=Cemetery+Mapping'">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section py-5">
    <div class="container">
      <div class="row text-center">
        <div class="col-md-3">
          <div class="stat-card">
            <h2 class="display-4 fw-bold text-primary" id="stat-cemeteries"><%= stats.total_cemeteries || 0 %></h2>
            <p class="text-muted"><i class="fas fa-tree me-2"></i>Cemeteries</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card">
            <h2 class="display-4 fw-bold text-success" id="stat-graves"><%= stats.total_graves || 0 %></h2>
            <p class="text-muted"><i class="fas fa-cross me-2"></i>Graves</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card">
            <h2 class="display-4 fw-bold text-info" id="stat-visits"><%= stats.total_visits || 0 %></h2>
            <p class="text-muted"><i class="fas fa-users me-2"></i>Visits</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card">
            <h2 class="display-4 fw-bold text-warning" id="stat-photos"><%= stats.total_photos || 0 %></h2>
            <p class="text-muted"><i class="fas fa-camera me-2"></i>Photos</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Graves Section -->
  <% if (recentGraves && recentGraves.length > 0) { %>
  <section class="py-5 bg-light">
    <div class="container">
      <h2 class="text-center mb-5">Recently Added Graves</h2>
      <div class="row g-4">
        <% recentGraves.forEach(grave => { %>
          <div class="col-md-4 col-lg-4">
            <div class="card h-100 grave-card">
              <div class="grave-image-container">
                <% if (grave.primary_photo) { %>
                  <img src="<%= grave.primary_photo %>" class="card-img-top" alt="<%= grave.deceased_name %>" style="height: 200px; object-fit: cover;">
                <% } else { %>
                  <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                    <i class="fas fa-cross fa-3x text-white"></i>
                  </div>
                <% } %>
              </div>
              <div class="card-body">
                <h5 class="card-title"><%= grave.deceased_name %></h5>
                <p class="card-text text-muted">
                  <small>
                    <i class="fas fa-calendar-alt me-1"></i>
                    <%= grave.birth_date ? new Date(grave.birth_date).toLocaleDateString() : '?' %> - 
                    <%= grave.death_date ? new Date(grave.death_date).toLocaleDateString() : '?' %>
                  </small>
                </p>
                <p class="card-text">
                  <small class="text-muted">
                    <i class="fas fa-map-pin me-1"></i>
                    <%= grave.cemetery_name || 'Unknown Cemetery' %>
                    <%= grave.section ? `| Section ${grave.section}` : '' %>
                  </small>
                </p>
                <a href="/graves/<%= grave.id %>" class="btn btn-primary btn-sm">View Details</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <div class="text-center mt-4">
        <a href="/graves" class="btn btn-outline-primary">View All Graves</a>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Features Section -->
  <section class="features-section py-5">
    <div class="container">
      <h2 class="text-center mb-5">Key Features</h2>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100 text-center p-4 feature-card">
            <div class="feature-icon">
              <i class="fas fa-map-location-dot fa-3x text-primary"></i>
            </div>
            <h4>Interactive Map</h4>
            <p>Visualize cemeteries and graves on an interactive map with GPS coordinates and directions.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 text-center p-4 feature-card">
            <div class="feature-icon">
              <i class="fas fa-magnifying-glass-location fa-3x text-primary"></i>
            </div>
            <h4>Smart Search</h4>
            <p>Search for graves by name, date, section, or cemetery with real-time results.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 text-center p-4 feature-card">
            <div class="feature-icon">
              <i class="fas fa-memory fa-3x text-primary"></i>
            </div>
            <h4>Preserve Memories</h4>
            <p>Upload photos, share memories, and maintain family history records with epitaphs.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section py-5 bg-primary text-white">
    <div class="container text-center">
      <h2 class="mb-4">Ready to Explore?</h2>
      <p class="lead mb-4">Start your journey to find and preserve memories of loved ones.</p>
      <a href="/map" class="btn btn-light btn-lg">
        <i class="fas fa-arrow-right me-2"></i>Explore Map
      </a>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/main.js"></script>
</body>
</html>
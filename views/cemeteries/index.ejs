<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Cemeteries</h2>
      <% if (isAuthenticated) { %>
        <a href="/cemeteries/new" class="btn btn-primary">
          <i class="fas fa-plus me-2"></i>Add Cemetery
        </a>
      <% } %>
    </div>

    <div class="row g-4">
      <% if (cemeteries && cemeteries.length > 0) { %>
        <% cemeteries.forEach(cemetery => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card cemetery-card h-100">
              <% if (cemetery.image_url) { %>
                <img src="<%= cemetery.image_url %>" class="card-img-top" alt="<%= cemetery.name %>" style="height: 200px; object-fit: cover;">
              <% } else { %>
                <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                  <i class="fas fa-tree fa-4x text-white opacity-50"></i>
                </div>
              <% } %>
              <div class="card-body">
                <h5 class="card-title"><%= cemetery.name %></h5>
                <p class="card-text text-muted">
                  <small>
                    <i class="fas fa-map-pin me-1"></i>
                    <%= cemetery.city || '' %> <%= cemetery.state || '' %> <%= cemetery.country || '' %>
                  </small>
                </p>
                <p class="card-text">
                  <small>
                    <i class="fas fa-cross me-1"></i>
                    <%= cemetery.grave_count || 0 %> graves
                    <% if (cemetery.established_year) { %>
                      <span class="ms-2"><i class="fas fa-calendar me-1"></i><%= cemetery.established_year %></span>
                    <% } %>
                  </small>
                </p>
                <p class="card-text">
                  <small class="text-muted"><%= cemetery.address %></small>
                </p>
                <a href="/cemeteries/<%= cemetery.id %>" class="btn btn-primary btn-sm">View Details</a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <div class="text-center py-5">
            <i class="fas fa-tree fa-4x text-muted mb-3"></i>
            <h4>No Cemeteries Found</h4>
            <p class="text-muted">Start by adding your first cemetery.</p>
            <% if (isAuthenticated) { %>
              <a href="/cemeteries/new" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add Cemetery
              </a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
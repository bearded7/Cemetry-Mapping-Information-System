<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="container py-4">
    <!-- Cemetery Header -->
    <div class="card mb-4">
      <div class="row g-0">
        <div class="col-md-4">
          <% if (cemetery.image_url) { %>
            <img src="<%= cemetery.image_url %>" class="img-fluid rounded-start" alt="<%= cemetery.name %>" style="height: 100%; object-fit: cover;">
          <% } else { %>
            <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 100%; min-height: 250px;">
              <i class="fas fa-tree fa-5x text-white opacity-50"></i>
            </div>
          <% } %>
        </div>
        <div class="col-md-8">
          <div class="card-body">
            <h2 class="card-title"><%= cemetery.name %></h2>
            <p class="card-text"><%= cemetery.description || 'No description available.' %></p>
            
            <div class="row mt-3">
              <div class="col-md-6">
                <p><strong><i class="fas fa-map-pin me-2"></i>Address</strong></p>
                <p class="text-muted"><%= cemetery.address %></p>
                <p><%= cemetery.city || '' %> <%= cemetery.state || '' %> <%= cemetery.country || '' %></p>
              </div>
              <div class="col-md-6">
                <p><strong><i class="fas fa-info-circle me-2"></i>Details</strong></p>
                <p><i class="fas fa-cross me-2"></i><%= cemetery.total_graves || 0 %> graves</p>
                <% if (cemetery.established_year) { %>
                  <p><i class="fas fa-calendar me-2"></i>Est. <%= cemetery.established_year %></p>
                <% } %>
                <% if (cemetery.opening_hours) { %>
                  <p><i class="fas fa-clock me-2"></i><%= cemetery.opening_hours %></p>
                <% } %>
              </div>
            </div>

            <div class="mt-3">
              <% if (cemetery.contact_phone) { %>
                <a href="tel:<%= cemetery.contact_phone %>" class="btn btn-outline-primary btn-sm">
                  <i class="fas fa-phone me-2"></i><%= cemetery.contact_phone %>
                </a>
              <% } %>
              <% if (cemetery.contact_email) { %>
                <a href="mailto:<%= cemetery.contact_email %>" class="btn btn-outline-primary btn-sm">
                  <i class="fas fa-envelope me-2"></i><%= cemetery.contact_email %>
                </a>
              <% } %>
              <% if (cemetery.website_url) { %>
                <a href="<%= cemetery.website_url %>" target="_blank" class="btn btn-outline-primary btn-sm">
                  <i class="fas fa-globe me-2"></i>Website
                </a>
              <% } %>
              <% if (cemetery.latitude && cemetery.longitude) { %>
                <a href="https://www.openstreetmap.org/?mlat=<%= cemetery.latitude %>&mlon=<%= cemetery.longitude %>" 
                   target="_blank" class="btn btn-success btn-sm">
                  <i class="fas fa-directions me-2"></i>Directions
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Graves List -->
    <h3 class="mb-3">Graves in <%= cemetery.name %></h3>
    <% if (graves && graves.length > 0) { %>
      <div class="row g-4">
        <% graves.forEach(grave => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card grave-card h-100">
              <div class="grave-image-container">
                <% if (grave.primary_photo) { %>
                  <img src="<%= grave.primary_photo %>" class="card-img-top" alt="<%= grave.deceased_name %>" style="height: 200px; object-fit: cover;">
                <% } else { %>
                  <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                    <i class="fas fa-cross fa-3x text-white opacity-50"></i>
                  </div>
                <% } %>
              </div>
              <div class="card-body">
                <h5 class="card-title"><%= grave.deceased_name %></h5>
                <p class="card-text text-muted">
                  <small>
                    <i class="fas fa-calendar-alt me-1"></i>
                    <%= grave.birth_date ? new Date(grave.birth_date).toLocaleDateString() : '?' %> - 
                    <%= grave.death_date ? new Date(grave.death_date).toLocaleDateString() : '?' %>
                  </small>
                </p>
                <p class="card-text">
                  <small class="text-muted">
                    <%= grave.section ? `Section ${grave.section}` : '' %>
                    <%= grave.plot_number ? `| Plot ${grave.plot_number}` : '' %>
                  </small>
                </p>
                <a href="/graves/<%= grave.id %>" class="btn btn-primary btn-sm">View Grave</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <i class="fas fa-cross fa-4x text-muted mb-3"></i>
        <h4>No Graves Found</h4>
        <p class="text-muted">There are no graves recorded in this cemetery yet.</p>
        <% if (isAuthenticated) { %>
          <a href="/graves/new" class="btn btn-success">
            <i class="fas fa-plus me-2"></i>Add Grave
          </a>
        <% } %>
      </div>
    <% } %>

    <div class="mt-4">
      <a href="/cemeteries" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Cemeteries
      </a>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>